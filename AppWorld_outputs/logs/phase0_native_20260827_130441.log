│  note_ids = []                                                                                                                                                                                       │
│  page_index = 0                                                                                                                                                                                      │
│  while True:                                                                                                                                                                                         │
│      page_notes = apis.simple_note.search_notes(access_token=access_token, page_index=page_index)                                                                                                    │
